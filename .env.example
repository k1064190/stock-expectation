# Copy to `.env` and fill in. `.env` is gitignored.
# stock-cli and the scheduler scripts auto-load this via python-dotenv.

# --- Existing (Stage 1, optional) ---
# Financial Modeling Prep — fundamentals + earnings calendar (free 250/day).
FMP_API_KEY=

# Alpaca paper-trading account — only needed by portfolio-manager skill.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- Stage 2: news + disclosures ---

# Finnhub — US company news (free 60 req/min). https://finnhub.io
FINNHUB_API_KEY=

# Alpha Vantage — US news sentiment scores (free 25/day, 5/min).
# Optional; without it /expect's news_score sentiment component is 0.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Open DART — Korean regulatory disclosures (free, no rate limit).
# https://opendart.fss.or.kr/uss/umt/EgovMberInsertView.do
OPEN_DART_API_KEY=

# --- Scheduler delivery (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Daily briefing API mode (optional) ---
# Only needed if running scheduler/daily_briefing.py --mode api.
ANTHROPIC_API_KEY=

# --- Stage 7-B: Neo4j ---
# Required when `docker compose up -d neo4j` and `stock-cli graph *` are used.
# Pick any password; compose.yml will fail at startup if this is unset.
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
